# Copy this to .env.local and fill in your values
# Get these from: Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# The email address of the admin account (must be registered in Supabase Auth)
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourschool.edu.ng

# Supabase service role key (for admin operations — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Random string used to sign student session cookies (generate a long random string)
SESSION_SECRET=your-session-secret-here

# ─── Email Providers (at least one required for OTP emails) ──────────────────
# The system tries Resend first, then Brevo, then Mailjet. Configure whichever
# provider(s) you have access to.

# Resend (primary)
# https://resend.com > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_DOMAIN=your-domain.com

# Brevo / Sendinblue (fallback 1)
# https://app.brevo.com > Settings > API Keys
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@your-domain.com
BREVO_SENDER_NAME=NACOS Voting

# Mailjet (fallback 2)
# https://app.mailjet.com > API Key Management
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_API_SECRET=your-mailjet-api-secret
MAILJET_SENDER_EMAIL=noreply@your-domain.com
MAILJET_SENDER_NAME=NACOS Voting
