# Copy this to .env.local and fill in your values
# Get these from: Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# The email address of the admin account (must be registered in Supabase Auth)
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourschool.edu.ng

# Supabase service role key (for admin operations — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Flutterwave ────────────────────────────────────────────────────────────
# Get these from: https://dashboard.flutterwave.com > Settings > API Keys
# Use test keys for development, live keys for production
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_WEBHOOK_SECRET_HASH=your-webhook-secret-hash-here

# ─── Email (optional, for admin invitations) ──────────────────────────────
# Resend (https://resend.com > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_DOMAIN=your-domain.com
